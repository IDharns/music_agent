MUSIC_DB_PATH=data/music.db
MUSIC_INDEX_PATH=data/faiss.index
MUSIC_IDS_PATH=data/ids.npy

# Number of Million Song Dataset metadata rows to import during auto-bootstrap.
# Use 0 for all rows.
MUSIC_BOOTSTRAP_TRACK_LIMIT=10000

# Optional LLM query rewrite / rerank through OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ENABLE_LLM_QUERY_REWRITE=1
ENABLE_LLM_RERANK=1

# Optional Last.fm enrichment for offline rebuilds.
LASTFM_API_KEY=
